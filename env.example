# GitHub API Configuration
# Obtén tu token en: https://github.com/settings/tokens
# Necesitas permisos: repo (para crear ramas, subir archivos y crear PRs)

VITE_GITHUB_TOKEN=your_github_token_here
VITE_GITHUB_OWNER=organization
VITE_GITHUB_REPO=first-aid-resources

# Instrucciones:
# 1. Copia este archivo a .env (cp env.example .env)
# 2. Reemplaza 'your_github_token_here' con tu token real de GitHub
# 3. Ajusta OWNER y REPO según tu repositorio
# 4. El archivo .env está en .gitignore y no se subirá al repositorio

